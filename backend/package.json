{
  "name": "sieqi-backend",
  "version": "1.0.0",
  "description": "Cloudflare Worker Backend for IEQI Monitoring System",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create sieqi-db",
